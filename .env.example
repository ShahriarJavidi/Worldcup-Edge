# Copy to .env and fill in. Never commit .env.

# Claude (https://console.anthropic.com). Not needed if you've run `ant auth login`.
ANTHROPIC_API_KEY=
# API-Football v3 (https://www.api-football.com), used by `wm context`
FOOTBALL_API_KEY=

# Optional overrides
# WM_MODEL=claude-opus-5-5
# WM_EFFORT=medium            # low | medium | high | xhigh | max
# WM_DB_PATH=rag_chroma_db
# WM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
